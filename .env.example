# Copy to .env. Never commit a real key.
# Scaffold does not make paid calls, even when a key is present.
APP_MODE=scaffold
OPENAI_API_KEY=
# Models verified in bounded local live runs. APP_MODE=live requires these choices.
OPENAI_ROUTER_MODEL=gpt-6-luna
OPENAI_ROUTER_REASONING_EFFORT=low
# Experimental; keep false for the validated routing profile.
OPENAI_ROUTER_COMPACT_OUTPUT=false
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
# Local conservative request reservations; not a replacement for an OpenAI project spend limit.
SESSION_BUDGET_USD=1.0
RUN_BUDGET_USD=5.0
