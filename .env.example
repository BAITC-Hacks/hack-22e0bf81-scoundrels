# Copy to .env. Never commit a real key.
# Scaffold does not make paid calls, even when a key is present.
APP_MODE=scaffold
OPENAI_API_KEY=
# Router owner selects an available model after evaluating starter-kit data.
OPENAI_ROUTER_MODEL=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Proposed application guardrail; NOT enforced by this initial scaffold.
# Platform owner must implement accounting + a hard stop before enabling live mode.
SESSION_BUDGET_USD=1.0
RUN_BUDGET_USD=5.0
